# ===== Majburiy =====
# BotFather bergan token
BOT_TOKEN=1234567890:AA...
# Botning foydalanuvchi nomi (@ belgisisiz)
BOT_USERNAME=huquqsavoljavob_bot
# Admin(lar)ning Telegram ID raqami (vergul bilan). ID ni @userinfobot dan bilish mumkin
ADMIN_IDS=123456789
# Server manzili (https, oxirida / yo'q) — Mini App (ilova) va admin panel shu manzilda ochiladi
WEBAPP_URL=https://sizning-servis.up.railway.app

# ===== Kanal (bot shu kanalda ADMIN bo'lishi shart — a'zolikni tekshirish uchun) =====
CHANNEL=@huquqsavoljavob
CHANNEL_URL=https://t.me/huquqsavoljavob

# ===== Ixtiyoriy =====
# Admin panelga brauzer orqali kirish paroli (Telegram ichidan kirish uchun shart emas)
ADMIN_PANEL_PASSWORD=
# Baza fayli (Railway'da doimiy disk /data ga ulanadi — Dockerfile'da shunday sozlangan)
# DB_PATH=/data/bot.sqlite3
# Payme/Click to'lov tokeni (BotFather → Payments). Bo'sh qolsa — chek orqali to'lov
PAYMENT_PROVIDER_TOKEN=
